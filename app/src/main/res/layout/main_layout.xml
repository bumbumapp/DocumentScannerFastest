<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bento_ground"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Bento header: greeting + big title, square actions. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jakarta_medium"
                    android:text="@string/bento_greeting_evening"
                    android:textColor="@color/bento_muted"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/jakarta_extrabold"
                    android:letterSpacing="-0.03"
                    android:singleLine="true"
                    android:text="@string/bento_home_title"
                    android:textColor="@color/bento_text"
                    android:textSize="32sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/iv_search"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bento_square_action"
                android:contentDescription="@string/bento_search"
                android:onClick="onClick"
                android:padding="11dp"
                android:src="@drawable/ic_search"
                app:tint="@color/bento_text" />

            <ImageView
                android:id="@+id/iv_more"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bento_square_action"
                android:contentDescription="@string/bento_more"
                android:onClick="onClick"
                android:padding="11dp"
                android:src="@drawable/ic_more"
                app:tint="@color/bento_text" />
        </LinearLayout>

        <RelativeLayout
            android:id="@+id/rl_search_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bento_search_bg"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_close_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="6dp"
                android:onClick="onClick"
                android:padding="10dp"
                android:src="@drawable/ic_search"
                app:tint="@color/bento_muted" />

            <EditText
                android:id="@+id/et_search"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/iv_clear_txt"
                android:layout_toEndOf="@+id/iv_close_search"
                android:background="@color/transparent"
                android:cursorVisible="true"
                android:focusable="true"
                android:fontFamily="@font/jakarta_medium"
                android:hint="Search for Document..."
                android:imeOptions="actionDone"
                android:inputType="text"
                android:textColor="@color/bento_text"
                android:textColorHint="@color/bento_muted"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/iv_clear_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="6dp"
                android:onClick="onClick"
                android:padding="8dp"
                android:src="@drawable/ic_close_black_24dp"
                android:visibility="invisible"
                app:tint="@color/bento_muted" />
        </RelativeLayout>

        <!-- Hero tile: scan with the camera. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/hero_scan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="20dp"
            android:clickable="true"
            android:focusable="true"
            android:onClick="onClick"
            app:cardBackgroundColor="@color/bento_accent"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp">

                <FrameLayout
                    android:layout_width="62dp"
                    android:layout_height="52dp">

                    <View
                        android:layout_width="34dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="26dp"
                        android:alpha="0.5"
                        android:background="@drawable/bento_page"
                        android:rotation="10" />

                    <View
                        android:layout_width="34dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="13dp"
                        android:alpha="0.75"
                        android:background="@drawable/bento_page"
                        android:rotation="3" />

                    <View
                        android:layout_width="34dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/bento_page"
                        android:rotation="-7" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jakarta_bold"
                        android:letterSpacing="-0.02"
                        android:text="@string/bento_hero_title"
                        android:textColor="@color/bento_on_accent"
                        android:textSize="21sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:alpha="0.85"
                        android:fontFamily="@font/jakarta_medium"
                        android:text="@string/bento_hero_subtitle"
                        android:textColor="@color/bento_on_accent"
                        android:textSize="14sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bento_hero_circle"
                    android:importantForAccessibility="no"
                    android:padding="12dp"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/bento_on_accent" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Pastel tool tiles. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tile_import"
                style="@style/BentoTile"
                android:layout_marginEnd="5dp"
                android:onClick="onClick">

                <LinearLayout style="@style/BentoTileBody">

                    <ImageView
                        style="@style/BentoTileIcon"
                        android:backgroundTint="@color/bento_tile_photos_bg"
                        android:src="@drawable/ic_import_gallery"
                        app:tint="@color/bento_tile_photos_fg" />

                    <TextView
                        style="@style/BentoTileLabel"
                        android:text="@string/bento_tile_import" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/iv_folder"
                style="@style/BentoTile"
                android:layout_marginStart="5dp"
                android:onClick="onClick">

                <LinearLayout style="@style/BentoTileBody">

                    <ImageView
                        style="@style/BentoTileIcon"
                        android:backgroundTint="@color/bento_tile_folder_bg"
                        android:src="@drawable/ic_baseline_create_new_folder_24"
                        app:tint="@color/bento_tile_folder_fg" />

                    <TextView
                        style="@style/BentoTileLabel"
                        android:text="@string/bento_tile_folder" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tag_tabs"
            style="@style/CustomTabLayout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bento_tabs_bg"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            app:tabGravity="start"
            app:tabIndicator="@drawable/bento_tab_pill"
            app:tabIndicatorColor="@color/bento_accent"
            app:tabIndicatorFullWidth="true"
            app:tabIndicatorGravity="stretch"
            app:tabMode="scrollable"
            app:tabRippleColor="@android:color/transparent"
            app:tabSelectedTextColor="@color/bento_on_accent"
            app:tabTextColor="@color/bento_muted" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="6dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_group"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="8dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/ly_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingBottom="30dp"
                android:visibility="visible">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@drawable/ffbb" />

                <TextView
                    android:id="@+id/tv_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/jakarta_semibold"
                    android:gravity="center"
                    android:singleLine="true"
                    android:text="@string/noDocumentScan"
                    android:textColor="@color/bento_muted"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Kept for code compatibility; the hero tile is the scan entry point. -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/iv_group_camera"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:onClick="onClick"
                android:src="@drawable/btn_floating_icon"
                android:visibility="gone" />
        </RelativeLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/adView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
